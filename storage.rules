rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /resumes/{userId}/{fileName} {
      // Authenticated users can read resumes (Employers need to view applicants' resumes).
      // The unguessable download URL generated by Firebase provides the primary access control.
      allow read: if request.auth != null;
      
      // Only the specific user can upload/overwrite their own resume
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
