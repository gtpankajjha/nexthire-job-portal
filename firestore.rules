rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'ADMIN';
    }

    // -------------------------------------------------------------------------
    // USERS
    // -------------------------------------------------------------------------
    match /users/{userId} {

      // Kept unchanged for now because employers need candidate
      // profile information in the applicant flow.
      allow read: if isAuthenticated();

      allow create: if isOwner(userId)
                    && request.resource.data.role in [
                      'SEEKER',
                      'EMPLOYER'
                    ];

      allow update: if (
                      isOwner(userId)
                      && request.resource.data.role == resource.data.role
                    )
                    || isAdmin();

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // COMPANIES
    // -------------------------------------------------------------------------
    match /companies/{companyId} {

      allow read: if true;

      allow create: if isAuthenticated()
                    && getUserRole() == 'EMPLOYER'
                    && request.resource.data.employerId == request.auth.uid;

      allow update: if isAuthenticated()
                    && resource.data.employerId == request.auth.uid
                    && request.resource.data.employerId == request.auth.uid;

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // JOBS
    // -------------------------------------------------------------------------
    match /jobs/{jobId} {

      allow read: if resource.data.status == 'ACTIVE'
                  || (
                    isAuthenticated()
                    && resource.data.employerId == request.auth.uid
                  )
                  || isAdmin();

      allow create: if isAuthenticated()
                    && getUserRole() == 'EMPLOYER'
                    && request.resource.data.employerId == request.auth.uid;

      allow update: if (
                      isAuthenticated()
                      && resource.data.employerId == request.auth.uid
                      && request.resource.data.employerId == resource.data.employerId
                    )
                    || isAdmin();

      allow delete: if (
                      isAuthenticated()
                      && resource.data.employerId == request.auth.uid
                    )
                    || isAdmin();
    }

    // -------------------------------------------------------------------------
    // APPLICATIONS
    // -------------------------------------------------------------------------
    match /applications/{applicationId} {

      allow read: if (
                    isAuthenticated()
                    && (
                      resource.data.seekerId == request.auth.uid
                      || resource.data.employerId == request.auth.uid
                    )
                  )
                  || isAdmin();

      // Candidate can create an application only for themselves,
      // only for an ACTIVE job, and initial status must be Applied.
      allow create: if isAuthenticated()
                    && getUserRole() == 'SEEKER'
                    && request.resource.data.seekerId == request.auth.uid
                    && request.resource.data.status == 'Applied'
                    && exists(
                      /databases/$(database)/documents/jobs/$(request.resource.data.jobId)
                    )
                    && get(
                      /databases/$(database)/documents/jobs/$(request.resource.data.jobId)
                    ).data.employerId == request.resource.data.employerId
                    && get(
                      /databases/$(database)/documents/jobs/$(request.resource.data.jobId)
                    ).data.status == 'ACTIVE';

      // Employer can change ONLY status.
      // Status must be one of the valid ApplicationStatus values.
      allow update: if isAuthenticated()
                    && resource.data.employerId == request.auth.uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['status'])
                    && request.resource.data.status in [
                      'Applied',
                      'Shortlisted',
                      'Interview',
                      'Selected',
                      'Rejected'
                    ];

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // SAVED JOBS
    // -------------------------------------------------------------------------
    match /saved_jobs/{savedJobId} {

      allow read: if isAuthenticated()
                  && resource.data.seekerId == request.auth.uid;

      // Candidate can save only an ACTIVE job.
      allow create: if isAuthenticated()
                    && getUserRole() == 'SEEKER'
                    && request.resource.data.seekerId == request.auth.uid
                    && exists(
                      /databases/$(database)/documents/jobs/$(request.resource.data.jobId)
                    )
                    && get(
                      /databases/$(database)/documents/jobs/$(request.resource.data.jobId)
                    ).data.status == 'ACTIVE';

      allow update: if false;

      allow delete: if isAuthenticated()
                    && resource.data.seekerId == request.auth.uid;
    }
  }
}